# Токен бота из @BotFather (команда /newbot или /token)
BOT_TOKEN=

# Telegram ID координаторов и админов через запятую
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Контакт координатора, который показывается в разделе «Связаться»
CONTACT_URL=https://t.me/lapka_dobra_coord

# Ссылки проекта
SITE_URL=https://lapka-dobra.ru
DOBRO_URL=https://dobro.ru

# Часовой пояс для «Лапки дня» (по умолчанию Екатеринбург)
TIMEZONE=Asia/Yekaterinburg
